NODE_ENV=development
LOG_LEVEL=info

TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_ADMIN_CHAT_ID=-1000000000000
TELEGRAM_CHANNEL_USERNAME=@replace_me
TELEGRAM_CHANNEL_URL=https://t.me/replace_me

CONTENT_BOT_KEY=telegram-service-bot
DIRECTUS_ENABLED=false
DIRECTUS_URL=http://localhost:8055
DIRECTUS_TOKEN=replace-with-read-only-token
CONTENT_CACHE_TTL_SECONDS=60
YANDEX_DISK_TOKEN=
# Необязательно: пустое значение использует TELEGRAM_ADMIN_CHAT_ID.
TELEGRAM_MEDIA_CHAT_ID=
MEDIA_POLL_INTERVAL_SECONDS=20
MEDIA_BATCH_SIZE=3
TELEGRAM_UPLOAD_TIMEOUT_SECONDS=600

DATABASE_URL=postgresql://telegram_service:telegram_service@localhost:5433/telegram_service
DATABASE_SSL=false

PRIVACY_POLICY_URL=https://example.com/privacy
PRIVACY_CONTACT_EMAIL=owner@example.com
PRIVACY_CONTACT_TELEGRAM=https://t.me/replace_me

HEALTH_PORT=8090
TELEGRAM_POLL_TIMEOUT_SECONDS=30
TELEGRAM_REQUEST_TIMEOUT_SECONDS=35
# Необязательно: HTTP-прокси для сетей, где Telegram API недоступен напрямую.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,directus,database
SESSION_TTL_HOURS=24
APPLICATION_RETENTION_DAYS=30
