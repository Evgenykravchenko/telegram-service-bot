BOT_IMAGE=ghcr.io/evgenykravchenko/telegram-service-bot
BOT_VERSION=0.1.1
NODE_ENV=production
LOG_LEVEL=info
TELEGRAM_BOT_TOKEN=replace-on-server
TELEGRAM_ADMIN_CHAT_ID=-1000000000000
TELEGRAM_CHANNEL_USERNAME=@replace_me
TELEGRAM_CHANNEL_URL=https://t.me/replace_me
CONTENT_BOT_KEY=telegram-service-bot
DIRECTUS_ENABLED=true
DIRECTUS_URL=http://directus:8055
DIRECTUS_TOKEN=replace-on-server
CONTENT_CACHE_TTL_SECONDS=60
YANDEX_DISK_TOKEN=replace-on-server
TELEGRAM_MEDIA_CHAT_ID=
MEDIA_POLL_INTERVAL_SECONDS=20
MEDIA_BATCH_SIZE=3
TELEGRAM_UPLOAD_TIMEOUT_SECONDS=600
DATABASE_URL=postgresql://replace-on-server
DATABASE_SSL=false
PRIVACY_POLICY_URL=https://replace.example/privacy
PRIVACY_CONTACT_EMAIL=replace@example.com
PRIVACY_CONTACT_TELEGRAM=https://t.me/replace_me
HEALTH_PORT=8090
TELEGRAM_POLL_TIMEOUT_SECONDS=30
TELEGRAM_REQUEST_TIMEOUT_SECONDS=35
HTTP_PROXY=http://xray_vless:8080
HTTPS_PROXY=http://xray_vless:8080
NO_PROXY=localhost,127.0.0.1,directus,database
SESSION_TTL_HOURS=24
APPLICATION_RETENTION_DAYS=30
